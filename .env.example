# STACKIT AI Model Serving (same endpoint pattern as coa-equal-rewards)
LLM_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B

# Persistence (Compose overrides this to sqlite:////data/vacature.db)
DATABASE_URL=sqlite:///./data/vacature.db

# Scanner
SCAN_INTERVAL_HOURS=6
CONFIDENCE_CANDIDATE=0.7
CONFIDENCE_REVIEW=0.4
AGENT_MAX_LISTINGS=25
AGENT_MAX_PAGES=5
REQUEST_DELAY_SECONDS=1.0

# Set to 1 to disable background scheduler (useful for one-off debug)
# DISABLE_SCHEDULER=0
